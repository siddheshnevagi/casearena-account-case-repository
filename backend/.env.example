# Copy to .env and fill in real values for your environment.
# Never commit the real .env file — it is in .gitignore.

ENVIRONMENT=development
DEBUG=true

# Postgres in staging/production (Google Cloud SQL, per ARCHITECTURE.md ADR-01).
# Example for the docker-compose Postgres service:
#   DATABASE_URL=postgresql+psycopg2://casearena:casearena@localhost:5432/casearena
# SQLite is fine for a zero-dependency local smoke test:
DATABASE_URL=sqlite:///./dev.db

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_STORAGE_DIR=./storage/uploads

# Where uploaded PDFs live: "local" | "database" | "s3".
#
# Do NOT use "local" in any hosted deployment — almost every PaaS wipes
# local disk on redeploy or restart, silently destroying every uploaded
# PDF. Use "database" (bytes in Postgres; no extra account or credentials,
# what the demo deployment uses) or "s3" (AWS S3, or Cloudflare R2 via
# S3_ENDPOINT_URL; the right choice past demo volumes).
# See docs/DEPLOYMENT.md and ARCHITECTURE.md ADR-07.
STORAGE_BACKEND=local

# Only read when STORAGE_BACKEND=s3. Leave S3_ENDPOINT_URL blank for real
# AWS S3; set it to the provider's endpoint for R2/MinIO/etc.
S3_BUCKET_NAME=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Comma-separated list is not supported directly by pydantic-settings for
# list[str] env vars without a parser; set via a JSON array string instead.
#
# Currently pointed at the sturdy-space-meme-wvvrp47qrwv6fx46 Codespace's
# forwarded frontend port for live testing there — swap back to
# ["http://localhost:5173"] once that Codespace's session is done, or for
# any other environment/Codespace (the forwarded hostname is unique per
# Codespace instance, and changes every time a Codespace is recreated).
CORS_ALLOW_ORIGINS=["https://sturdy-space-meme-wvvrp47qrwv6fx46-5173.app.github.dev","http://localhost:5173"]
